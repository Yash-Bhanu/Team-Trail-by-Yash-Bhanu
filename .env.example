# TeamTrail Environment Configuration
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local or any file containing real secrets

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://teamtrail:teamtrail_dev@localhost:5432/teamtrail_dev
DATABASE_URL_TEST=postgresql://teamtrail:teamtrail_dev@localhost:5432/teamtrail_test

# ── Better Auth ───────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_A_SECURE_SECRET
BETTER_AUTH_URL=http://localhost:3000

# ── GitHub OAuth (for user login) ─────────────────────────
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME

# ── GitHub App (for repository integration) ───────────────
GITHUB_APP_ID=CHANGE_ME
GITHUB_APP_PRIVATE_KEY=CHANGE_ME_BASE64_ENCODED_PEM
GITHUB_APP_SLUG=CHANGE_ME
GITHUB_WEBHOOK_SECRET=CHANGE_ME_GENERATE_A_SECURE_SECRET

# ── Application ──────────────────────────────────────────
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
